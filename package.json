{
  "name": "pyria-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:assets": "node scripts/build-assets.mjs",
    "dev": "npm run build:assets && wrangler dev",
    "deploy": "npm run build:assets && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply pyria-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pyria-db --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261127.1",
    "typescript": "^5.8.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.169.0"
  }
}
