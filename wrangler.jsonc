{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pyria",
  "main": "worker/index.ts",
  "compatibility_date": "2025-03-01",
  "routes": [
    {
      "pattern": "play.pyria.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/py-sandbox.html",
      "/new",
      "/new/*",
      "/play",
      "/play/*",
      "/console",
      "/console/*",
      "/admin",
      "/admin/*",
      "/builder",
      "/builder/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pyria-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Comma-separated list of admin email addresses (e.g. "admin@example.com")
    "PYRIA_ADMIN_EMAILS": "",
    // Public Google OAuth 2.0 Client ID for Parent Console sign-in
    "GOOGLE_CLIENT_ID": ""
    // Required production secrets (set via `wrangler secret put`):
    // - PYRIA_SESSION_SECRET (32+ random bytes for HMAC-SHA256 cookies & Hero Code hashes)
    // - GOOGLE_CLIENT_SECRET (Google OAuth 2.0 Client Secret)
  }
}
