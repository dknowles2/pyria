{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pyria",
  "main": "worker/index.ts",
  "compatibility_date": "2025-03-01",
  // Preserve runtime variables & secrets configured in the Cloudflare Dashboard
  // (PYRIA_ADMIN_EMAILS, GOOGLE_CLIENT_ID, PYRIA_SESSION_SECRET, GOOGLE_CLIENT_SECRET).
  "keep_vars": true,
  "routes": [
    {
      "pattern": "play.pyria.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/py-sandbox.html",
      "/new",
      "/new/*",
      "/play",
      "/play/*",
      "/console",
      "/console/*",
      "/admin",
      "/admin/*",
      "/builder",
      "/builder/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pyria-db",
      "database_id": "87992442-0ecc-4ae7-8c5c-ab6e466efdcf",
      "migrations_dir": "migrations"
    }
  ]
}
